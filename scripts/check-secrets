#!/usr/bin/env bash
set -euo pipefail
repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$repo"
scanner=$(git rev-parse --git-path gitleaks-bin)
if [[ ! -x "$scanner" ]]; then
  scanner=$(command -v gitleaks) || {
    echo "Install gitleaks or run scripts/setup-git-hooks first." >&2
    exit 1
  }
fi
"$scanner" dir --redact --no-banner --ignore-gitleaks-allow --config .gitleaks.toml .
"$scanner" git --redact --no-banner --ignore-gitleaks-allow --config .gitleaks.toml --log-opts=--all .
