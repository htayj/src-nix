xkb_keymap {
  xkb_keycodes {
    include "evdev+aliases(qwerty)"
    <LVL3> = 92;
    <ZEHA> = 93;
  };
  xkb_types { include "complete" };
  xkb_compatibility { include "complete" };
  xkb_symbols {
    include "pc+us"
    name[Group1] = "manna-cadet";
    // Clear pc's keysym-based Alt/Meta map as well as physical keys.
    // Otherwise xkbcommon puts LALT (Meta_L) in both Mod1 and Mod3.
    modifier_map None { <RALT>, <LCTL>, <RWIN>, <LALT>, <LWIN>, Alt_L, Alt_R, Meta_L, Meta_R };
    replace key <RALT> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Alt_L ] };
    replace modifier_map Mod1 { <RALT> };
    replace key <LCTL> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Control_L ] };
    replace modifier_map Control { <LCTL> };
    replace key <RWIN> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Hyper_L ] };
    replace modifier_map Mod2 { <RWIN>, <HYPR> };
    replace key <LALT> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Meta_L ] };
    replace modifier_map Mod3 { <LALT>, <META> };
    replace key <LWIN> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Super_L ] };
    replace modifier_map Mod4 { <LWIN> };
    key <AB01> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U7A, U5A, Greek_zeta, Greek_ZETA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ downcaret, NoSymbol ] };
    key <AB02> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U78, U58, Greek_xi, Greek_XI ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ downstile, NoSymbol ] };
    key <AB03> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U63, U43, Greek_chi, Greek_CHI ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ upstile, NoSymbol ] };
    key <AB04> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U76, U56, Greek_finalsmallsigma, Greek_SIGMA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ similarequal, NoSymbol ] };
    key <AB05> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U62, U42, Greek_beta, Greek_BETA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ identical, NoSymbol ] };
    key <AB06> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U6E, U4E, Greek_nu, Greek_NU ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ lessthanequal, NoSymbol ] };
    key <AB07> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U6D, U4D, Greek_mu, Greek_MU ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ greaterthanequal, NoSymbol ] };
    key <AB08> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ comma, less, guillemetleft, U300A ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AB09> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ period, greater, guillemetright, U300B ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AB10> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ slash, question, integral, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AC01> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U61, U41, Greek_alpha, Greek_ALPHA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ uptack, NoSymbol ] };
    key <AC02> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U73, U53, Greek_sigma, Greek_SIGMA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ downtack, NoSymbol ] };
    key <AC03> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U64, U44, Greek_delta, Greek_DELTA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ righttack, NoSymbol ] };
    key <AC04> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U66, U46, Greek_phi, Greek_PHI ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ lefttack, NoSymbol ] };
    key <AC05> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U67, U47, Greek_gamma, Greek_GAMMA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ uparrow, NoSymbol ] };
    key <AC06> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U68, U48, Greek_eta, Greek_ETA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ downarrow, NoSymbol ] };
    key <AC07> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U6A, U4A, U3D1, U3F4 ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ leftarrow, NoSymbol ] };
    key <AC08> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U6B, U4B, Greek_kappa, Greek_KAPPA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ rightarrow, NoSymbol ] };
    key <AC09> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U6C, U4C, Greek_lambda, Greek_LAMBDA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ U2194, NoSymbol ] };
    key <AC10> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ semicolon, colon, diaeresis, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AC11> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ apostrophe, quotedbl, periodcentered, U387 ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AD01> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U71, U51, Greek_theta, Greek_THETA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ upcaret, NoSymbol ] };
    key <AD02> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U77, U57, Greek_omega, Greek_OMEGA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ downcaret, NoSymbol ] };
    key <AD03> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U65, U45, Greek_epsilon, Greek_EPSILON ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ downshoe, NoSymbol ] };
    key <AD04> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U72, U52, Greek_rho, Greek_RHO ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ upshoe, NoSymbol ] };
    key <AD05> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U74, U54, Greek_tau, Greek_TAU ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ leftshoe, NoSymbol ] };
    key <AD06> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U79, U59, Greek_psi, Greek_PSI ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ rightshoe, NoSymbol ] };
    key <AD07> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U75, U55, Greek_upsilon, Greek_UPSILON ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ U2200, NoSymbol ] };
    key <AD08> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U69, U49, Greek_iota, Greek_IOTA ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ infinity, NoSymbol ] };
    key <AD09> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U6F, U4F, Greek_omicron, Greek_OMICRON ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ U2203, NoSymbol ] };
    key <AD10> { type[Group1]="FOUR_LEVEL_ALPHABETIC", symbols[Group1]=[ U70, U50, Greek_pi, Greek_PI ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ partialderivative, NoSymbol ] };
    key <AD11> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ bracketleft, braceleft, U27E6, U2983 ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AD12> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ bracketright, braceright, U27E7, U2984 ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE01> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U31, exclam, dagger, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE02> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U32, at, doubledagger, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE03> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U33, numbersign, opentribulletdown, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE04> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U34, dollar, cent, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE05> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U35, percent, circle, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE06> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U36, asciicircum, U25AF, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE07> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U37, ampersand, division, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE08> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U38, asterisk, multiply, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE09> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U39, parenleft, paragraph, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE10> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ U30, parenright, emopencircle, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE11> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ minus, underscore, U2248, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <AE12> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ equal, plus, U2205, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <BKSL> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ backslash, bar, U2016, brokenbar ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <BKSP> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ BackSpace, BackSpace, BackSpace, BackSpace ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ BackSpace, BackSpace ] };
    key <COMP> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ F18 ] };
    key <DELE> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Delete ] };
    key <DOWN> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Down ] };
    key <END> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE00D ] };
    key <ESC> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Escape ] };
    key <HOME> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Home ] };
    key <I150> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ F21 ] };
    key <I191> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE000 ] };
    key <I192> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE001 ] };
    key <I193> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE002 ] };
    key <I194> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE003 ] };
    key <I195> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE004 ] };
    key <I196> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE005 ] };
    key <I197> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE006 ] };
    key <I198> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE007 ] };
    key <I199> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE008 ] };
    key <I200> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE009 ] };
    key <I201> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE011 ] };
    key <I202> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE00C ] };
    key <I203> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE00A ] };
    key <I204> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE00B ] };
    key <I205> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE012 ] };
    key <I206> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE013 ] };
    key <I207> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE014 ] };
    key <I219> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE00F ] };
    key <I220> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE010 ] };
    key <I226> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U2160 ] };
    key <I227> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U2161 ] };
    key <I228> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U2162 ] };
    key <I229> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U2163 ] };
    key <I230> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U261A ] };
    key <I231> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U1F44D ] };
    key <I232> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U1F44E ] };
    key <I233> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ U261B ] };
    key <I234> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE00E ] };
    key <I248> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ UE00D ] };
    key <LEFT> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Left ] };
    key <PGDN> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Next ] };
    key <PGUP> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Prior ] };
    key <PROP> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ F19 ] };
    key <RGHT> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Right ] };
    key <RTRN> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ Return, NoSymbol, Linefeed, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ Return, NoSymbol ] };
    key <SPCE> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ space, NoSymbol, space, NoSymbol ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ space, NoSymbol ] };
    key <TAB> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ Tab, ISO_Left_Tab, Tab, ISO_Left_Tab ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ Tab, ISO_Left_Tab ] };
    key <TLDE> { type[Group1]="FOUR_LEVEL", symbols[Group1]=[ grave, asciitilde, grave, asciitilde ], type[Group2]="TWO_LEVEL", symbols[Group2]=[ NoSymbol, NoSymbol ] };
    key <UP> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Up ] };
    key <VOL+> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ F20 ] };
    replace key <LVL3> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ Mode_switch ] };
    modifier_map None { <LVL3> };
    replace key <ZEHA> { type[Group1]="ONE_LEVEL", symbols[Group1]=[ ISO_Level3_Shift ] };
    modifier_map Mod5 { <ZEHA> };
  };
  xkb_geometry { include "pc(pc105)" };
};
